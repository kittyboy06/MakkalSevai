# MakkalSevai Configuration (.env)

# Backend Server
PORT=8001
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database (PostGIS on port 5433 for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/makkalsevai
SYNC_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/makkalsevai

# Matching Engine Weights (Configurable during live judging demo)
MATCH_WEIGHT_DISTANCE=0.45
MATCH_WEIGHT_RATING=0.30
MATCH_WEIGHT_RELIABILITY=0.15
MATCH_WEIGHT_FAIRNESS=0.10
MATCH_DEFAULT_RADIUS_METERS=5000
MATCH_MAX_RADIUS_METERS=15000

# Auth Secrets
JWT_SECRET=makkalsevai-hackathon-supersecret-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay Test Mode Credentials (100% Free Sandbox)
RAZORPAY_KEY_ID=rzp_test_mockkey
RAZORPAY_KEY_SECRET=rzp_test_mocksecret

# Mock Government API Mode (DigiLocker, e-Shram)
ENABLE_MOCK_GOV_APIS=true

# Supabase Project (Connected via Supabase MCP)
SUPABASE_PROJECT_ID=ulplesjbvblspibdpspr
SUPABASE_URL=https://ulplesjbvblspibdpspr.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

